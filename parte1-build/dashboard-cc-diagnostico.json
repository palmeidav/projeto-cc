        "region": "us-east-2",
        "view": "table",
        "query": "SOURCE '/cc/chat-service' | SOURCE '/cc/catalog-orders-service' | SOURCE '/cc/order-worker' | fields @timestamp, service, level, message, erro | filter conversation_id = 'a845bb74d89c4f18869b1c3cd5979668' | sort @timestamp asc"
