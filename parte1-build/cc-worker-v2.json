{
  "containerDefinitions": [
    {
      "name": "order-worker",
      "image": "244736565328.dkr.ecr.us-east-2.amazonaws.com/cc/order-worker:v2",
      "cpu": 256,
      "memory": 512,
      "memoryReservation": 256,
      "portMappings": [],
      "essential": true,
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-2"
        },
        {
          "name": "DB_NAME",
          "value": "shop"
        },
        {
          "name": "QUEUE_URL",
          "value": "https://sqs.us-east-2.amazonaws.com/244736565328/cc-orders"
        },
        {
          "name": "TOPIC_ARN",
          "value": "arn:aws:sns:us-east-2:244736565328:cc-order-events"
        },
        {
          "name": "DB_HOST",
          "value": "cc-db.c23mtpyyxfro.us-east-2.rds.amazonaws.com"
        },
        {
          "name": "DB_USER",
          "value": "cc_admin"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "${DB_SECRET_ARN}:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/cc/order-worker",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "worker"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "test $(( $(date +%s) - $(stat -c %Y /tmp/heartbeat) )) -lt 90"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3
      },
      "systemControls": []
    }
  ],
  "family": "cc-worker",
  "taskRoleArn": "arn:aws:iam::244736565328:role/cc-worker-task-role",
  "executionRoleArn": "arn:aws:iam::244736565328:role/cc-task-exec-role",
  "networkMode": "bridge",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "EC2"
  ],
  "tags": [
    {
      "key": "project",
      "value": "cc"
    }
  ]
}
