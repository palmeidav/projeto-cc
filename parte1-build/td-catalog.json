{
 "family": "cc-catalog", "networkMode": "bridge", "requiresCompatibilities": ["EC2"],
 "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/cc-task-exec-role",
 "taskRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/cc-catalog-task-role",
 "containerDefinitions": [{
  "name": "catalog-orders-service", "image": "${REG}/cc/catalog-orders-service:v1", "essential": true,
  "cpu": 256, "memoryReservation": 256, "memory": 512,
  "portMappings": [{"containerPort": 8001, "hostPort": 0, "protocol": "tcp"}],
  "environment": [
   {"name": "AWS_REGION", "value": "us-east-2"},
   {"name": "DB_HOST", "value": "${DB_HOST}"},
   {"name": "DB_NAME", "value": "shop"},
   {"name": "DB_USER", "value": "cc_admin"},
   {"name": "QUEUE_URL", "value": "${Q_URL}"}],
  "secrets": [{"name": "DB_PASSWORD", "valueFrom": "${DB_SECRET_ARN}:password::"}],
  "healthCheck": {"command": ["CMD-SHELL", "curl -f http://localhost:8001/health || exit 1"],
   "interval": 15, "timeout": 5, "retries": 3, "startPeriod": 30},
  "logConfiguration": {"logDriver": "awslogs", "options": {"awslogs-group": "/cc/catalog-orders-service",
   "awslogs-region": "us-east-2", "awslogs-stream-prefix": "catalog"}}
 }],
 "tags": [{"key": "project", "value": "cc"}]
}
